#!/usr/bin/make -f

# The upstream nightly tarball is already the generated install tree (what
# upstream's `make install` produces), so nothing is built and nothing is
# downloaded at build time. The empty, world-writable run/ and cache.d/ are
# not shipped: ble.sh falls back to $XDG_RUNTIME_DIR / ~/.cache/blesh.

BLESH = debian/ble.sh/usr/share/blesh
AIRLINE = debian/ble.sh-airline-themes/usr/share/blesh/contrib

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:

override_dh_auto_install:
	install -d $(BLESH) $(AIRLINE)
	install -m 644 ble.sh $(BLESH)/ble.sh
	cp -r lib contrib $(BLESH)/
	install -m 644 debian/_package.bash $(BLESH)/lib/_package.bash
	mv $(BLESH)/contrib/airline $(AIRLINE)/airline

override_dh_installdocs:
	dh_installdocs -p ble.sh doc/*
	dh_installdocs --remaining-packages
